{
  "name": "royaumes-terre-du-milieu",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname localhost --port 3102",
    "build": "next build --webpack",
    "start": "next start --hostname localhost --port 3102",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "tsx --test app/*.test.ts",
    "format": "prettier --write app",
    "format:check": "prettier --check app",
    "predev": "node ../scripts/sync-catalog.mjs",
    "prebuild": "node ../scripts/sync-catalog.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "16.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
